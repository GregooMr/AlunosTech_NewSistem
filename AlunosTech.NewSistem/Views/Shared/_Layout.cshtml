@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var logado = Context.Session.GetInt32("AlunoId") is not null;
    var ehProfessor = Context.Session.GetString("Perfil") == "Professor";
    var nome = Context.Session.GetString("AlunoNome");
    var ra = Context.Session.GetString("AlunoRA");

    var cursosAtivo = controller == "Home" && (action is "Index" or "SalaDeAula" or "Certificado");

    string Ativo(string c, string? a = null) =>
        controller == c && (a is null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alunos Tech AVA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlunosTech.NewSistem.styles.css" asp-append-version="true" />
</head>
<body>
    @if (logado)
    {
        <div class="ava-topbar text-white py-2 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge-fill fs-4 text-info"></i>
                <div>
                    <span class="fw-bold">@nome</span>
                    @if (!string.IsNullOrEmpty(ra))
                    {
                        <span class="badge bg-light text-dark ms-2">RA: @ra</span>
                    }
                    @if (ehProfessor)
                    {
                        <span class="badge bg-info text-dark ms-2">Professor</span>
                    }
                </div>
            </div>
            <a asp-controller="Home" asp-action="Sair" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Sair</a>
        </div>

        <nav class="ava-subnav navbar navbar-expand navbar-dark px-4 py-2 shadow-sm">
            <ul class="navbar-nav gap-3 small fw-semibold text-uppercase flex-wrap">
                @if (ehProfessor)
                {
                    <li class="nav-item"><a class="nav-link @Ativo("Professor")" asp-controller="Professor" asp-action="Index">Área do Professor</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @(cursosAtivo ? "active" : "")" asp-controller="Home" asp-action="Index">Conteúdos Acadêmicos</a></li>
                }
                <li class="nav-item"><a class="nav-link @Ativo("Home", "Bibliotecas")" asp-controller="Home" asp-action="Bibliotecas">Bibliotecas</a></li>
                <li class="nav-item"><a class="nav-link @Ativo("Home", "MuralDoAluno")" asp-controller="Home" asp-action="MuralDoAluno">Mural do Aluno</a></li>
                <li class="nav-item"><a class="nav-link @Ativo("Home", "Tutoriais")" asp-controller="Home" asp-action="Tutoriais">Tutoriais</a></li>
                @if (!ehProfessor)
                {
                    <li class="nav-item"><a class="nav-link @Ativo("Forum")" asp-controller="Forum" asp-action="Index">Dúvidas</a></li>
                }
            </ul>
        </nav>
    }

    <div class="container py-4">
        @if (TempData["Erro"] is string erro)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@erro
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }
        @if (TempData["Aviso"] is string aviso)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@aviso
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }
        @if (TempData["Sucesso"] is string sucesso)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@sucesso
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Alunos Tech · Ambiente Virtual de Aprendizagem
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
