@model IEnumerable<Matricula>
@{
    ViewData["Title"] = "Conteúdos Acadêmicos";
    var disponiveis = (IEnumerable<Curso>)ViewBag.CursosDisponiveis;
    var lista = Model.ToList();
}

<div class="ava-banner text-white py-4 text-center shadow-sm rounded-3 mb-4">
    <h2 class="fw-bolder mb-0" style="letter-spacing: 2px;">ALUNOS TECH <span class="text-warning">• AVA</span></h2>
    <small class="opacity-75">Portal de Ensino Digital Corporativo</small>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-grid-fill text-primary me-2"></i>Meus Cursos</h5>
    <span class="badge bg-primary rounded-pill">@lista.Count disciplinas</span>
</div>

@if (lista.Count == 0)
{
    <div class="alert alert-info">Você ainda não está matriculado em nenhuma disciplina. Use o formulário abaixo para se matricular.</div>
}

<div class="row g-4 mb-5">
    @foreach (var item in lista)
    {
        var badge = item.Status switch
        {
            "Ativa" => "bg-success",
            "Trancada" => "bg-warning text-dark",
            "Concluida" => "bg-info text-dark",
            _ => "bg-secondary"
        };
        <div class="col-md-6 col-lg-4">
            <div class="card course-card shadow-sm h-100">
                <div class="card-header bg-primary text-white py-3 rounded-top-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <small class="opacity-75 d-block">Cód: @item.Curso.Codigo</small>
                        <span class="badge @badge">@item.Status</span>
                    </div>
                    <h6 class="fw-bold mb-0 text-truncate">@item.Curso.Titulo</h6>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <p class="text-muted small mb-2"><i class="bi bi-person-video3 me-1"></i>@(item.Curso.Professor?.Nome ?? "Professor a definir")</p>
                        <p class="small text-secondary">@item.Curso.Descricao</p>
                    </div>
                    <div class="mt-3">
                        <div class="d-flex justify-content-between small fw-bold mb-1">
                            <span>Progresso</span>
                            <span class="text-primary">@item.ProgressoPercentual%</span>
                        </div>
                        <div class="progress mb-3" style="height: 8px;" role="progressbar" aria-valuenow="@item.ProgressoPercentual" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(item.ProgressoPercentual >= 100 ? "bg-success" : "bg-primary")" style="width: @(item.ProgressoPercentual)%"></div>
                        </div>

                        @if (item.Status == "Ativa")
                        {
                            <a asp-action="SalaDeAula" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 fw-semibold">
                                <i class="bi bi-door-open me-1"></i>Acessar Disciplina
                            </a>
                        }
                        else if (item.Status == "Concluida")
                        {
                            <div class="small text-muted mb-2">Nota final: <strong>@(item.NotaFinal?.ToString("0.00") ?? "-")</strong></div>
                            <a asp-action="Certificado" asp-route-id="@item.Id" class="btn btn-success w-100 fw-semibold">
                                <i class="bi bi-award-fill me-1"></i>Ver certificado
                            </a>
                        }
                        else if (item.Status == "Trancada")
                        {
                            <form asp-action="AlterarStatus" method="post">
                                <input type="hidden" name="matriculaId" value="@item.Id" />
                                <input type="hidden" name="status" value="Ativa" />
                                <button class="btn btn-warning w-100 fw-semibold"><i class="bi bi-unlock me-1"></i>Reativar matrícula</button>
                            </form>
                        }

                        @if (item.Status == "Ativa" || item.Status == "Trancada")
                        {
                            <div class="d-flex gap-2 mt-2">
                                @if (item.Status == "Ativa")
                                {
                                    <form asp-action="AlterarStatus" method="post" class="flex-fill">
                                        <input type="hidden" name="matriculaId" value="@item.Id" />
                                        <input type="hidden" name="status" value="Trancada" />
                                        <button class="btn btn-sm btn-outline-warning w-100">Trancar</button>
                                    </form>
                                }
                                <form asp-action="AlterarStatus" method="post" class="flex-fill" onsubmit="return confirm('Deseja realmente cancelar esta matrícula?');">
                                    <input type="hidden" name="matriculaId" value="@item.Id" />
                                    <input type="hidden" name="status" value="Cancelada" />
                                    <button class="btn btn-sm btn-outline-danger w-100">Desmatricular</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card border-0 shadow-sm p-4">
    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-plus-circle-fill me-2"></i>Matricular em Nova Disciplina</h5>
    @if (!disponiveis.Any())
    {
        <p class="text-muted mb-0">Você já está matriculado em todas as disciplinas disponíveis.</p>
    }
    else
    {
        <form asp-action="AdicionarCurso" method="post" class="row g-3 align-items-center">
            <div class="col-md-9">
                <select name="cursoId" class="form-select form-select-lg fs-6" required>
                    <option value="">Selecione uma disciplina disponível...</option>
                    @foreach (var c in disponiveis)
                    {
                        <option value="@c.Id">@c.Codigo - @c.Titulo</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">Efetuar Matrícula</button>
            </div>
        </form>
    }
</div>
