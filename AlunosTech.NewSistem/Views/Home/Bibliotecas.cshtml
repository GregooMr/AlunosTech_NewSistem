@{
    ViewData["Title"] = "Bibliotecas";
    var acervo = new[]
    {
        (Titulo: "Clean Architecture", Autor: "Robert C. Martin", Tipo: "E-book", Area: "Arquitetura de software"),
        (Titulo: "Designing Data-Intensive Applications", Autor: "Martin Kleppmann", Tipo: "E-book", Area: "Banco de dados"),
        (Titulo: "The DevOps Handbook", Autor: "Gene Kim et al.", Tipo: "E-book", Area: "Cloud e DevOps"),
        (Titulo: "Guia do Scrum", Autor: "Schwaber & Sutherland", Tipo: "Normativa", Area: "Gestão ágil"),
        (Titulo: "Boas práticas de índices no SQL Server", Autor: "Equipe Tec Logos", Tipo: "Artigo", Area: "Banco de dados"),
        (Titulo: "Injeção de dependência no ASP.NET Core", Autor: "Equipe Tec Logos", Tipo: "Artigo", Area: "Programação .NET"),
        (Titulo: "Containers em produção: do Docker ao Kubernetes", Autor: "Equipe Tec Logos", Tipo: "Artigo", Area: "Cloud e DevOps"),
        (Titulo: "LGPD aplicada a sistemas educacionais", Autor: "Núcleo Jurídico Alunos Tech", Tipo: "Normativa", Area: "Segurança e conformidade"),
        (Titulo: "Armazenamento seguro de senhas", Autor: "Equipe Tec Logos", Tipo: "Artigo", Area: "Segurança e conformidade"),
    };
}

<h2 class="text-primary fw-bold"><i class="bi bi-book me-2"></i>Biblioteca Digital Alunos Tech</h2>
<p class="text-muted">Acervo bibliográfico online com e-books, artigos científicos e normativas de tecnologia. (Conteúdo simulado para demonstração.)</p>

<div class="row g-2 mb-4">
    <div class="col-md-6">
        <input id="busca" type="search" class="form-control" placeholder="Buscar por título, autor ou área..." />
    </div>
    <div class="col-md-6 d-flex gap-2 flex-wrap" id="filtros">
        <button type="button" class="btn btn-sm btn-primary" data-tipo="">Todos</button>
        <button type="button" class="btn btn-sm btn-outline-primary" data-tipo="E-book">E-books</button>
        <button type="button" class="btn btn-sm btn-outline-primary" data-tipo="Artigo">Artigos</button>
        <button type="button" class="btn btn-sm btn-outline-primary" data-tipo="Normativa">Normativas</button>
    </div>
</div>

<div class="row g-3" id="acervo">
    @foreach (var item in acervo)
    {
        <div class="col-md-6 col-lg-4 item-acervo" data-tipo="@item.Tipo" data-texto="@($"{item.Titulo} {item.Autor} {item.Area}".ToLowerInvariant())">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <span class="badge bg-primary mb-2">@item.Tipo</span>
                    <h6 class="fw-bold">@item.Titulo</h6>
                    <p class="small text-muted mb-1">@item.Autor</p>
                    <p class="small text-secondary mb-0"><i class="bi bi-tag me-1"></i>@item.Area</p>
                </div>
            </div>
        </div>
    }
</div>
<p id="vazio" class="text-muted mt-3 d-none">Nenhum item encontrado.</p>

@section Scripts {
    <script>
        (function () {
            var tipoAtual = "";
            var busca = document.getElementById("busca");
            var itens = document.querySelectorAll(".item-acervo");
            var vazio = document.getElementById("vazio");

            function filtrar() {
                var termo = busca.value.trim().toLowerCase();
                var visiveis = 0;
                itens.forEach(function (el) {
                    var ok = (!tipoAtual || el.dataset.tipo === tipoAtual) && (!termo || el.dataset.texto.indexOf(termo) >= 0);
                    el.classList.toggle("d-none", !ok);
                    if (ok) visiveis++;
                });
                vazio.classList.toggle("d-none", visiveis > 0);
            }

            busca.addEventListener("input", filtrar);
            document.querySelectorAll("#filtros button").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    tipoAtual = btn.dataset.tipo;
                    document.querySelectorAll("#filtros button").forEach(function (b) {
                        b.classList.toggle("btn-primary", b === btn);
                        b.classList.toggle("btn-outline-primary", b !== btn);
                    });
                    filtrar();
                });
            });
        })();
    </script>
}
