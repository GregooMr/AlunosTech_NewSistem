@{
    ViewData["Title"] = "Mural do Aluno";
    var avisos = new[]
    {
        (Categoria: "Prazo", Cor: "danger", Data: "19/11/2026", Titulo: "Prazo final do PIM VIII", Texto: "A entrega final do projeto integrador PIM VIII encerra em 19 de novembro."),
        (Categoria: "Sistema", Cor: "warning", Data: "20/11/2026", Titulo: "Manutenção do sistema legado", Texto: "Manutenção programada do sistema legado no fim de semana. O novo AVA permanece disponível."),
        (Categoria: "Novidade", Cor: "success", Data: "16/11/2026", Titulo: "Novo AVA no ar", Texto: "Conheça a nova plataforma: progresso por disciplina, canal de dúvidas e emissão de certificado."),
        (Categoria: "Provas", Cor: "primary", Data: "18/11/2026", Titulo: "Provas finais liberadas", Texto: "A prova final é liberada ao concluir 100% dos conteúdos da disciplina. Nota mínima: 7,0."),
        (Categoria: "Biblioteca", Cor: "info", Data: "12/11/2026", Titulo: "Novos títulos no acervo", Texto: "Foram adicionados e-books e artigos sobre arquitetura de software, DevOps e bancos de dados."),
    };
}

<h2 class="text-primary fw-bold"><i class="bi bi-megaphone me-2"></i>Mural de Avisos Institucionais</h2>
<p class="text-muted">Comunicados e lembretes importantes da Alunos Tech. (Conteúdo simulado para demonstração.)</p>

<div class="list-group shadow-sm">
    @foreach (var aviso in avisos)
    {
        <div class="list-group-item py-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-@aviso.Cor @(aviso.Cor is "warning" or "info" ? "text-dark" : "")">@aviso.Categoria</span>
                <small class="text-muted">@aviso.Data</small>
            </div>
            <h6 class="fw-bold mb-1">📌 @aviso.Titulo</h6>
            <p class="mb-0 text-secondary">@aviso.Texto</p>
        </div>
    }
</div>
