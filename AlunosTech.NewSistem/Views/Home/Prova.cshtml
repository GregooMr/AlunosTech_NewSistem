@model ProvaViewModel
@{
    // Modo focado: sem barra de navegação/guia rápida.
    Layout = null;
    var letras = new[] { "A", "B", "C", "D", "E" };
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Prova final | Alunos Tech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="exam-page">
    <main class="container py-5" style="max-width:760px">
        <div class="text-center mb-5">
            <span class="badge text-bg-primary mb-3">AVALIAÇÃO FINAL</span>
            <h1>@Model.Matricula.Curso.Titulo</h1>
            <p class="text-muted">Responda todas as questões. A nota é calculada automaticamente.</p>
        </div>

        <form asp-action="ConcluirProva" method="post" onsubmit="return confirm('Deseja enviar a prova? Não será possível alterar as respostas.');">
            <input type="hidden" name="matriculaId" value="@Model.Matricula.Id" />

            @foreach (var questao in Model.Questoes)
            {
                <div class="card border-0 shadow-sm question-card mb-3">
                    <div class="card-body">
                        <p class="fw-semibold mb-3">@questao.Id. @questao.Enunciado</p>
                        @for (var i = 0; i < questao.Alternativas.Count; i++)
                        {
                            var campo = $"respostas[{questao.Id}]";
                            var idCampo = $"q{questao.Id}_{i}";
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="@campo" id="@idCampo" value="@i" required />
                                <label class="form-check-label" for="@idCampo">@letras[i]) @questao.Alternativas[i]</label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="alert alert-info">A aprovação exige nota mínima @Model.NotaMinima.ToString("0.0"). Ao ser aprovado, o certificado é emitido automaticamente.</div>
            <button class="btn btn-primary btn-lg" type="submit">Concluir prova</button>
            <a asp-action="SalaDeAula" asp-route-id="@Model.Matricula.Id" class="btn btn-link">Voltar sem concluir</a>
        </form>
    </main>
</body>
</html>
