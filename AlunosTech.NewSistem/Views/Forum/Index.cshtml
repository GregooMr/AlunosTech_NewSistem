@model IReadOnlyList<DuvidaForum>
@{
    ViewData["Title"] = "Dúvidas com professores";
    var cursos = (ViewBag.Cursos as IEnumerable<Curso>) ?? Enumerable.Empty<Curso>();
    int? selecionado = ViewBag.CursoSelecionado as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><span class="eyebrow">COMUNICAÇÃO</span><h1 class="h2">Dúvidas com professores</h1></div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Meus cursos</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h5>Enviar uma dúvida</h5>
        @if (!cursos.Any())
        {
            <p class="text-muted mb-0">Matricule-se em uma disciplina para enviar dúvidas ao professor.</p>
        }
        else
        {
            <form asp-action="Perguntar" method="post" class="row g-3">
                <div class="col-md-4">
                    <select name="cursoId" class="form-select" required>
                        <option value="">Selecione a disciplina</option>
                        @foreach (var curso in cursos)
                        {
                            <option value="@curso.Id" selected="@(selecionado == curso.Id)">@curso.Titulo</option>
                        }
                    </select>
                </div>
                <div class="col-md-6"><input name="pergunta" maxlength="2000" class="form-control" placeholder="Escreva sua pergunta..." required /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100">Enviar</button></div>
            </form>
        }
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Você ainda não enviou nenhuma dúvida.</p>
}

@foreach (var duvida in Model)
{
    <article class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <strong>@duvida.Curso.Titulo</strong>
                <small class="text-muted">@duvida.DataPergunta.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
            </div>
            <p class="mt-3 mb-2">@duvida.Pergunta</p>
            @if (!string.IsNullOrWhiteSpace(duvida.RespostaProfessor))
            {
                <div class="answer-box">
                    <strong>Resposta do professor</strong>
                    <p class="mb-0 mt-1">@duvida.RespostaProfessor</p>
                </div>
            }
            else
            {
                <span class="badge text-bg-warning">Aguardando resposta</span>
            }
        </div>
    </article>
}
